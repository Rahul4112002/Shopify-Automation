# Copy this file to .env (same folder as app.py) for local runs.
# On Vercel, add the same keys under Project Settings > Environment Variables instead.

# Google Gemini API key for AI-written LAVIE titles (from https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: model id(s) to try first, comma separated. Default: gemini-3.5-flash-lite
# GEMINI_MODEL=gemini-3.5-flash-lite
